# Copy this file to `.env` (same folder) and fill in the key. `.env` is git-ignored.
# On Render / other hosts set the same names as environment variables instead.

OPENAI_API_KEY=

# ---- Optional overrides (defaults shown) -------------------------------------------------
# Planner: question -> structured query plan (accuracy-critical, small output)
# OPENAI_PLANNER_MODEL=gpt-6-luna
# Used only if the planner's plan fails validation twice, or the first model is unavailable
# OPENAI_PLANNER_FALLBACK_MODEL=gpt-6.1-sol
# Narrator: verified numbers -> short prose
# OPENAI_NARRATOR_MODEL=gpt-6-luna
# Leave empty to omit the parameter for models that do not support it
# OPENAI_PLANNER_REASONING_EFFORT=low
# OPENAI_NARRATOR_REASONING_EFFORT=low
# OPENAI_TIMEOUT_S=45

# Switch the assistant off without removing the code
# CHAT_ENABLED=true
# Per-IP questions per minute (0 = unlimited)
# CHAT_RATE_LIMIT_PER_MIN=20
